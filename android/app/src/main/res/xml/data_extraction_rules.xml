<?xml version="1.0" encoding="utf-8"?>
<!--
  备份规则：不允许云端备份。
  卡号是敏感信息，备份必须是用户主动导出的加密文件（ADR-0013），
  而不是系统自动上传到 Google 云。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
