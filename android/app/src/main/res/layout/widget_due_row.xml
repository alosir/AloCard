<?xml version="1.0" encoding="utf-8"?>
<!-- 待还行：银行徽标 + 银行名 · 状态 + 金额 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/due_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/due_mark"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:gravity="center"
        android:background="@drawable/widget_mark_bg"
        android:textColor="#211D18"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/due_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:textColor="#E6E0D6"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/due_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F5E2B4"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
