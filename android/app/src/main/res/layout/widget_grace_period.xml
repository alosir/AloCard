<?xml version="1.0" encoding="utf-8"?>
<!--
  今日免息期小组件布局（ADR-0012）。

  用 RemoteViews 而非 Glance：本产品的列表是静态的 5 行文本 + 排名，
  Glance 的声明式能力（状态、交互）在这里用不上，而 RemoteViews
  更轻、无额外依赖、且在 Android 12+ 的桌面尺寸自适应上够用。
  后续若需要点击行进详情，再评估迁移到 Glance。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            tools:text="10/24" />
    </LinearLayout>

    <!--
      TOP 5 账单组行容器。
      不静态 include 5 行——那 5 行会共享 row_bank/row_days 同一组 id，
      RemoteViews 无法区分。改为空容器，由代码用 addView 动态填充。
    -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp" />

</LinearLayout>
